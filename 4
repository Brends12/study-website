body {
  font-family: Arial;
  background: #eef2f7;
  text-align: center;
  padding: 20px;
}

.card {
  background: white;
  padding: 20px;
  margin: 20px auto;
  width: 90%;
  max-width: 500px;
  border-radius: 10px;
  box-shadow: 0 0 10px rgba(0,0,0,0.1);
}

button {
  padding: 10px;
  margin-top: 10px;
  border: none;
  background: #4CAF50;
  color: white;
  border-radius: 5px;
  cursor: pointer;
}

button:hover {
  background: #45a049;
}
